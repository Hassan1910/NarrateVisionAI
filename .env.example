# API Keys
# OpenAI API key for image generation and text-to-speech
OPENAI_API_KEY=your_openai_api_key_here

# API Configuration
# Set to 'openai' to use OpenAI directly, or 'zero2launch' to use Zero2Launch API
API_PROVIDER=openai

# Storage settings
VIDEO_OUTPUT_DIR=public/videos
# Use public/videos for Vercel compatibility

# FFmpeg Configuration
# Set to 'true' to show a warning if FFmpeg is not installed
SHOW_FFMPEG_WARNING=true

# Slideshow Configuration
# Maximum number of images to generate for slideshows (default: 4)
MAX_SLIDESHOW_IMAGES=4
# Duration of transitions between images in seconds (default: 1)
TRANSITION_DURATION=1

# Image Generation Configuration
# Default image style: 'natural' or 'vivid'
DEFAULT_IMAGE_STYLE=natural
# Default image size (width x height)
DEFAULT_IMAGE_SIZE=1024x1024

# Audio Configuration
# Default voice for text-to-speech
DEFAULT_VOICE=alloy
# Default audio quality (low, medium, high)
AUDIO_QUALITY=high
